*****************SUB*******************
.SUBCKT SUB VDD GND VOUT MPC MNC
XBIAS_BGR     VDD   VBIAS_BGR     GND   BIAS_BLOCK_2V_LOWI
XBIAS_CMP01   VDD   VBIAS_CMP01   GND   BIAS_BLOCK_2V_LOWI
XBIAS_TRI     VDD   VBIAS_TRI     GND   BIAS_BLOCK_2V_LOWI
XBIAS_EA      VDD   VBIAS_EA      GND   BIAS_BLOCK_2V_LOWI
XBIAS_PWMOSC  VDD   VBIAS_PWMOSC  GND   BIAS_BLOCK_2V_LOWI
XBIAS_PWMCMP  VDD   VBIAS_PWMCMP  GND   BIAS_BLOCK_2V_LOWI
XBIAS_PG      VDD   VBIAS_PG      GND   BIAS_BLOCK_2V_LOWI
XBIAS_MODE    VDD   VBIAS_MODE    GND   BIAS_BLOCK_2V_LOWI

XBGR_SS      VDD        GND        VBIAS_BGR    VBIAS_BGR    VREF   VREF_FIX   BANDGAP_SOFT_START

RFB_TOP      VOUT       VOUTR       3K
* PFM v11 Final: RFB_BOT=7.365K aligns PWM steady-state VOUT precisely to 1.8000V (matching PFM 1.8001V)
RFB_BOT      VOUTR      GND         7.365K

CFF          VOUT       VOUTR       4.7pF
RFB2_TOP     VOUT       VOUTR2      3.00K
* PFM v12: VREF_PFM filter (RPFM_REF/CPFM_REF/PFM_REF_START) removed, XCMP01 sees VREF directly.
* 7.52K -> 7.527K cancels the v11 filter's 0.318mV VREF->VREF_PFM drop so PFM VOUT stays put.
RFB2_BOT     VOUTR2     GND         7.527K

* PFM v14: local RC on XCMP01 VIN- only; VREF itself stays unloaded (v13 CVREF=390p on VREF
* slowed soft-start, missed PWM at 500mA, and did not reduce VREF noise). 22k/47p: tau 1.03us
* (same as v11 fast branch), pole 154kHz, ~14x at 2.2MHz. Linear RC keeps DC, so RFB2_BOT unchanged.
RCMP_REF     VREF       VREF_CMP    22K
CCMP_REF     VREF_CMP   GND         47pF

XCMP01       VDD        GND         VOUTR2     VREF_CMP   VBIAS_CMP01    S1          CMP01
* Retain the synchronized 296-MOS baseline's direct S1-to-XRS2 trigger path.

XTRIANGO_HZ  VDD        GND         VREF       VBIAS_TRI      VBIAS_TRI    RAMP_RST    PFM_QB     TRIANGO_HZ
XRS2         VDD        GND         RAMP_RST   S1         PFM_Q      PFM_QB      RS

XEA          VDD        GND         VOUTR      VREF       VBIAS_EA    VCOMP       EA

* Lead-lag PWM compensation: zero near 50kHz, high-frequency pole near 500kHz.
* Adds phase margin around the measured 250kHz duty-envelope oscillation.
RZ_PWM       VCOMP      VCOMP_CZ    160K
CZ_PWM       VCOMP_CZ   GND         20pF
CP_PWM       VCOMP      GND         2.2pF

XPWM_OSC     VDD        GND         VBIAS_PWMOSC      VREF       VBIAS_PWMOSC    RAMP        PWM_OSC
XPWM_CMP     VDD        GND         RAMP       VCOMP      VBIAS_PWMCMP    PWM_QB      CMP01

XPG_CMP      VDD        GND         VREF_FIX   VOUTR2     VBIAS_PG     PG          CMP01

XMODE_DET    VDD        GND         SW         MNC         VBIAS_MODE     VBIAS_MODE     VREF_FIX   PG       MODE     PFM_IDLE MODE_DET

XMUX_DUTY    VDD        GND         MODE       PFM_QB     PWM_QB     VDUTY_SEL   MUX2
X_DEAD_ZONE1 VDD        GND         VDUTY_SEL  VP_RAW_DEAD VN_RAW_DEAD PFM_LS_ALLOW DEAD_ZONE

* PFM low-side stop near zero current; +5.99mV SW sense bias at 3.3V
* is a starting point for comparator offset/delay compensation, not calibrated.
RZCD_SENSE   SW         SW_PFM_ZCD  100
* PFM v11 Final: RZCD_LEAD=45K provides verified early turn-off bias matching ZCD comparator delay
RZCD_LEAD    VDD        SW_PFM_ZCD  45K
XPFM_ZCD     VDD        GND         GND SW_PFM_ZCD VBIAS_MODE ZCD_PFM CMP_ZCD
XPFM_DIODE   VDD        GND         MODE VDUTY_SEL MNC ZCD_PFM PFM_IDLE PFM_LS_ALLOW PFM_DIODE_GATE

XDRV_P0      VDD        GND         VP_RAW_DEAD VP_MID1    INV
XDRV_P1      VDD        GND         VP_MID1     VP_MID2    INV_DRV1
XDRV_P2      VDD        GND         VP_MID2     VP_MID3    INV_DRV2
XDRV_P3      VDD        GND         VP_MID3     MPC        INV_DRV3
XDRV_N0      VDD        GND         VN_RAW_DEAD VN_MID1    INV
XDRV_N1      VDD        GND         VN_MID1     VN_MID2    INV_DRV1
XDRV_N2      VDD        GND         VN_MID2     VN_MID3    INV_DRV2
XDRV_N3      VDD        GND         VN_MID3     MNC        INV_DRV3

XBUCK        VDD        GND         VOUT       MPC        MNC        SW          BUCK

.ENDS

*****************BIAS_BLOCK_2V_LOWI*******************
.SUBCKT BIAS_BLOCK_2V_LOWI VDD VB VSS

M8   VB    VB    VDD   VDD   PCH3 W=0.3385714U L=0.800U M=7

M11  M9G   VB    VDD   VDD   PCH3 W=0.3385714U L=0.800U M=7

M12  M9G   M9G   M10G  VSS   NCH3 W=0.7142857U L=1.000U M=4

M13  M10G  M10G  VSS   VSS   NCH3 W=0.7142857U L=1.000U M=1

M9   VB    M9G   M9S   VSS   NCH3 W=0.7142857U L=1.000U M=1

M10  M9S   M10G  M10B  VSS   NCH3 W=0.7142857U L=1.000U M=4

R2   M10B  VSS  10.6688K

RSTART  VDD   M9G   5MEG

.ENDS BIAS_BLOCK_2V_LOWI


*****************TRIANGO_HZ*******************
.SUBCKT TRIANGO_HZ VDD GND VIN+ VBIAS VB_COMP VOUT PFM_QB

X_CMP        VDD        GND         VIN+       N_C1       VB_COMP    VOUT        CMP01

* PFM v11: C1=1.05pF locks switching frequency at ~2.22MHz (matching PWM 2.22MHz).
C1           N_C1       GND         1.05pF

M1           N_C1       VBIAS       VDD        VDD          PCH3         W=2u       L=4.25u     M=3
M2           N_C1       PFM_QB      GND        GND          NCH3         W=2u       L=0.35u     M=1

.ENDS


*****************CMP01*******************
.SUBCKT CMP01 VDD GND VIN+ VIN- VB_COMP VOUT

M_MB         N_TAIL     VB_COMP     VDD        VDD          PCH3         W=2u       L=1.0u      M=30

M_MP3        N_LOAD_L   VIN+        N_TAIL     VDD          PCH3         W=2u       L=0.5u      M=13
M_MP4        N_LOAD_R   VIN-        N_TAIL     VDD          PCH3         W=2u       L=0.5u      M=13

M_MN2        N_LOAD_L   N_LOAD_L    GND        GND          NCH3         W=2u       L=0.5u      M=8
M_MN5        N_LOAD_R   N_LOAD_R    GND        GND          NCH3         W=2u       L=0.5u      M=8
M_MN3        N_LOAD_R   N_LOAD_L    GND        GND          NCH3         W=2u       L=1.5u      M=1
M_MN4        N_LOAD_L   N_LOAD_R    GND        GND          NCH3         W=2u       L=1.5u      M=1

M_MP1        N_PGATE    N_PGATE     VDD        VDD          PCH3         W=2u       L=0.5u      M=9
M_MN1        N_PGATE    N_LOAD_L    GND        GND          NCH3         W=2u       L=0.5u      M=4

M_MP2        N_COMP_OUT N_PGATE     VDD        VDD          PCH3         W=2u       L=0.5u      M=9
M_MN6        N_COMP_OUT N_LOAD_R    GND        GND          NCH3         W=2u       L=0.5u      M=4

M_MP5        N_BUF1_OUT N_COMP_OUT  VDD        VDD          PCH3         W=2u       L=0.35u     M=2
M_MN7        N_BUF1_OUT N_COMP_OUT  GND        GND          NCH3         W=2u       L=0.35u     M=1

M_MP6        VOUT       N_BUF1_OUT  VDD        VDD          PCH3         W=2u       L=0.35u     M=4
M_MN8        VOUT       N_BUF1_OUT  GND        GND          NCH3         W=2u       L=0.35u     M=2

.ENDS


*****************EA*******************
.SUBCKT EA VDD GND VIN+ VIN- VB_COMP VOUT

M_MB         N_TAIL     VB_COMP     VDD        VDD          PCH3         W=2u       L=0.35u      M=20

M_MP3        N_LOAD_L   VIN+        N_TAIL     VDD          PCH3         W=2u       L=0.35u      M=10
M_MP4        VOUT       VIN-        N_TAIL     VDD          PCH3         W=2u       L=0.35u      M=10

M_MN2        N_LOAD_L   N_LOAD_L    GND        GND          NCH3         W=2u       L=0.35u      M=4
M_MN1        VOUT       N_LOAD_L    GND        GND          NCH3         W=2u       L=0.35u      M=4

.ENDS


*****************PWM_OSC*******************
.SUBCKT PWM_OSC VDD GND VBIAS VTH VB_COMP RAMP

X_CMP        VDD        GND         VTH        N_RCMP     VB_COMP    CLK         CMP01

RHYS_A       RAMP       N_RCMP      7K
RHYS_B       N_RCMP     CLK         46K

C2           RAMP       GND         200pF   $ calibrated from 452.395ns toward 450.25ns (2.221MHz)

M1           RAMP       VBIAS       VDD        VDD          PCH3         W=2u      L=0.35u    M=8
M2           RAMP       CLK         GND        GND          NCH3         W=2u      L=0.35u    M=1

.ENDS


*****************RS*******************
.SUBCKT RS VDD GND R S Q QB

XINV_S       VDD        GND         S          S_BAR      INV
XNOR_S       VDD        GND         S_BAR      R          S_EFF      NOR
XNOR_Q       VDD        GND         R          QB         Q          NOR
XNOR_QB      VDD        GND         S_EFF      Q          QB         NOR

.ENDS


*****************NOR*******************
.SUBCKT NOR VDD GND INA INB VOUT

M1           P1         INA         VDD        VDD          PCH3         W=2u       L=0.35u     M=2
M2           VOUT       INB         P1         VDD          PCH3         W=2u       L=0.35u     M=2
M3           VOUT       INA         GND        GND          NCH3         W=2u       L=0.35u     M=1
M4           VOUT       INB         GND        GND          NCH3         W=2u       L=0.35u     M=1

.ENDS


*****************INV*******************
.SUBCKT INV VDD GND VIN VOUT

M1           VOUT       VIN         VDD        VDD          PCH3         W=2u       L=0.35u     M=2
M2           VOUT       VIN         GND        GND          NCH3         W=2u       L=0.35u     M=1

.ENDS


*****************AND2*******************
.SUBCKT AND2 VDD GND INA INB VOUT

M1           OUT        INA         VDD        VDD          PCH3         W=2u       L=0.35u     M=2
M2           OUT        INB         VDD        VDD          PCH3         W=2u       L=0.35u     M=2
M3           OUT        INA         A          GND          NCH3         W=2u       L=0.35u     M=1
M4           A          INB         GND        GND          NCH3         W=2u       L=0.35u     M=1

XINV         VDD        GND         OUT        VOUT       INV

.ENDS


*****************OR2*******************
.SUBCKT OR2 VDD GND INA INB VOUT

XNOR         VDD        GND         INA        INB        N          NOR
XINV         VDD        GND         N          VOUT       INV

.ENDS


*****************MUX2*******************
.SUBCKT MUX2 VDD GND SEL INA INB VOUT

XINV_SEL     VDD        GND         SEL        SELB       INV
XAND_A       VDD        GND         SELB       INA        PA         AND2
XAND_B       VDD        GND         SEL        INB        PB         AND2
XOR_OUT      VDD        GND         PA         PB         VOUT       OR2

.ENDS


*****************DEAD_ZONE*******************
.SUBCKT DEAD_ZONE VDD GND VDUTY VP VN LS_ALLOW

XDLY_N       VDD        GND         VN         VN_D       DLY_CELL
XNOR1        VDD        GND         VDUTY      VN_D       A          NOR
XINV1        VDD        GND         A          B          INV
XBUFFER1     VDD        GND         B          VP         BUFFER_DZ

XDLY_P       VDD        GND         VP         VP_D       DLY_CELL
XINV2        VDD        GND         VP_D       C          INV
XINV3        VDD        GND         VDUTY      D          INV
XNOR2        VDD        GND         C          D          E          NOR
* Gate inside the interlock so its feedback observes the stopped low side.
X_LS_EN      VDD        GND         E          LS_ALLOW   E_EN       AND2
XBUFFER2     VDD        GND         E_EN       VN         BUFFER_DZ

.ENDS


*****************DLY_CELL*******************
.SUBCKT DLY_CELL VDD GND VIN VOUT

XD1          VDD        GND         VIN        N_D1       INV
R_DLY        N_D1       N_D2        60K
C_DLY        N_D2       GND         30fF
XD2          VDD        GND         N_D2       VOUT       INV

.ENDS


*****************BUFFER_DZ*******************
.SUBCKT BUFFER_DZ VDD GND VIN VOUT

X1           VDD        GND         VIN        A          INV
X2           VDD        GND         A          VOUT       INV_DZ_S2

.ENDS


*****************INV_DZ_S2*******************
.SUBCKT INV_DZ_S2 VDD GND VIN VOUT

M1           VOUT       VIN         VDD        VDD          PCH3         W=2u       L=0.35u     M=12
M2           VOUT       VIN         GND        GND          NCH3         W=2u       L=0.35u     M=5

.ENDS


*****************INV_DRV1*******************
.SUBCKT INV_DRV1 VDD GND VIN VOUT

M1           VOUT       VIN         VDD        VDD          PCH3         W=2u       L=0.35u     M=6
M2           VOUT       VIN         GND        GND          NCH3         W=2u       L=0.35u     M=3

.ENDS


*****************INV_DRV2*******************
.SUBCKT INV_DRV2 VDD GND VIN VOUT

M1           VOUT       VIN         VDD        VDD          PCH3         W=2u       L=0.35u     M=30
M2           VOUT       VIN         GND        GND          NCH3         W=2u       L=0.35u     M=10

.ENDS


*****************INV_DRV3*******************
.SUBCKT INV_DRV3 VDD GND VIN VOUT

M1           VOUT       VIN         VDD        VDD          PCH3         W=2u       L=0.35u     M=400
M2           VOUT       VIN         GND        GND          NCH3         W=2u       L=0.35u     M=200

.ENDS


*****************BUCK*******************
.SUBCKT BUCK VIN GND VOUT MPC MNC SW

MP           SW         MPC         VIN        VIN          PCH3         W=30u       L=0.35u     M=700
MN           SW         MNC         GND        GND          NCH3         W=30u       L=0.35u     M=350

L1           SW         VOUT        1.7uH
C1           C1N        GND         20uF
* PFM v8: restore 20m ESR to preserve verified PWM loop stability and phase margin.
RESR         VOUT       C1N         20m

* PFM v11 Final: C_SNUB=100pF, R_SNUB=220 completely damps 27MHz ringing and eliminates valley ripples
R_SNUB       SW         N_SNUB      220
C_SNUB       N_SNUB     GND         100pF

.ENDS


*****************PFM_DIODE_GATE*******************
.SUBCKT PFM_DIODE_GATE VDD GND MODE DUTY LS_GATE ZCD IDLE LS_ALLOW
* DUTY=0 starts the high-side pulse; MODE=1 continuously clears stop.
X_ON         VDD GND DUTY HS_ON                        INV
X_RST        VDD GND HS_ON MODE STOP_RST               OR2
* Qualify with actual MNC and its delayed copy to blank turn-on transients.
* RC=20ns; actual blanking depends on inverter threshold and loading.
X_BL_INV1    VDD GND LS_GATE BL_N                      INV
R_BL         BL_N BL_RC 20K
C_BL         BL_RC GND 1pF
X_BL_INV2    VDD GND BL_RC LS_DELAY                    INV
X_LS_VALID   VDD GND LS_GATE LS_DELAY LS_VALID         AND2
X_ZCD_SET    VDD GND ZCD LS_VALID STOP_SET             AND2
X_STOP       VDD GND STOP_RST STOP_SET IDLE IDLE_B     RS
* Latch stop through idle/ringing; PWM bypasses stop for synchronous operation.
X_ALLOW      VDD GND MODE IDLE_B LS_ALLOW              OR2
.ENDS 

*****************MODE_DET*******************
.SUBCKT MODE_DET VDD GND SW MNC_GATE VBIAS VB_COMP VTH_MODE PG MODE PFM_IDLE

XINV_PG      VDD        GND         PG          PG_B        INV

X_ZCD        VDD        GND         GND         SW          VB_COMP    ZCD_RAW     CMP_ZCD
X_AND_LS     VDD        GND         ZCD_RAW     MNC_GATE    ZCD_LS      AND2
X_AND_PG     VDD        GND         ZCD_LS      PG          ZCD_VALID   AND2

* A qualified PFM idle also arms/resets the timer: early shutoff may precede
* the original ZCD, and long idle is not evidence of continuous conduction.
X_ZCD_HOLD   VDD        GND         ZCD_VALID   PFM_IDLE    ZCD_HOLD    OR2
X_HOLD_PG    VDD        GND         ZCD_HOLD    PG          ZCD_SEEN    AND2
XARM         VDD        GND         PG_B        ZCD_SEEN    ARMED       ARMEDB      RS

M_CHG        N_TMR      VBIAS       VDD         VDD         PCH3         W=2u       L=1.75u      M=1
M_DIS        N_TMR      ZCD_SEEN    GND         GND         NCH3         W=2u       L=1.75u      M=4

M_TMR_RST    N_TMR      ARMEDB      GND         GND         NCH3         W=2u       L=0.35u      M=8

C_TMR        N_TMR      GND         8pF

X_MCMP       VDD        GND         VTH_MODE    N_TMR       VB_COMP     MODE        CMP_MODE

.ENDS


*****************CMP_MODE*******************
.SUBCKT CMP_MODE VDD GND VIN+ VIN- VB_COMP VOUT

M_MB         N_TAIL     VB_COMP     VDD        VDD          PCH3         W=2u       L=0.35u      M=6

M_MP3        N_LOAD_L   VIN+        N_TAIL     VDD          PCH3         W=2u       L=0.35u     M=2
M_MP4        N_LOAD_R   VIN-        N_TAIL     VDD          PCH3         W=2u       L=0.35u     M=2

M_MN2        N_LOAD_L   N_LOAD_L    GND        GND          NCH3         W=2u       L=0.35u     M=2
M_MN5        N_LOAD_R   N_LOAD_R    GND        GND          NCH3         W=2u       L=0.35u     M=2

M_MN3        N_LOAD_R   N_LOAD_L    GND        GND          NCH3         W=2u       L=0.35u     M=10
M_MN4        N_LOAD_L   N_LOAD_R    GND        GND          NCH3         W=2u       L=0.35u     M=8

M_MP1        N_PGATE    N_PGATE     VDD        VDD          PCH3         W=2u       L=0.35u     M=5
M_MN1        N_PGATE    N_LOAD_L    GND        GND          NCH3         W=2u       L=0.35u     M=2

M_MP2        N_COMP_OUT N_PGATE     VDD        VDD          PCH3         W=2u       L=0.35u     M=5
M_MN6        N_COMP_OUT N_LOAD_R    GND        GND          NCH3         W=2u       L=0.35u     M=2

M_MP5        N_BUF1_OUT N_COMP_OUT  VDD        VDD          PCH3         W=2u       L=0.35u     M=2
M_MN7        N_BUF1_OUT N_COMP_OUT  GND        GND          NCH3         W=2u       L=0.35u     M=1

M_MP6        VOUT       N_BUF1_OUT  VDD        VDD          PCH3         W=2u       L=0.35u     M=4
M_MN8        VOUT       N_BUF1_OUT  GND        GND          NCH3         W=2u       L=0.35u     M=2

.ENDS


*****************CMP_ZCD*******************
.SUBCKT CMP_ZCD VDD GND VIN_P VIN_N VB_COMP VOUT

MTAIL        N_TAIL     VB_COMP     VDD        VDD          PCH3         W=2u       L=0.35u     M=4

M1           N_DIFF1    VIN_P       N_TAIL     VDD          PCH3         W=2u       L=0.35u     M=6
M2           N_DIFF2    VIN_N       N_TAIL     VDD          PCH3         W=2u       L=0.35u     M=6



M3           N_DIFF1    N_DIFF1     GND        GND          NCH3         W=2u       L=0.35u     M=3
M4           N_DIFF2    N_DIFF1     GND        GND          NCH3         W=2u       L=0.35u     M=3

M5           N_MID      N_DIFF2     GND        GND          NCH3         W=2u       L=0.35u     M=6
M6           N_MID      VB_COMP     VDD        VDD          PCH3         W=2u       L=0.35u     M=3

M7           N_BUF1     N_MID       VDD        VDD          PCH3         W=2u       L=0.35u     M=4
M8           N_BUF1     N_MID       GND        GND          NCH3         W=2u       L=0.35u     M=2

M9           VOUT       N_BUF1      VDD        VDD          PCH3         W=2u       L=0.35u     M=4
M10          VOUT       N_BUF1      GND        GND          NCH3         W=2u       L=0.35u     M=2

.ENDS



*****************BANDGAP_SOFT_START*******************
.SUBCKT BANDGAP_SOFT_START VDD GND VB1 VB_COMP  VSOFT VREF_FIX

XBGR  VDD GND VREF_FIX BANDGAP

XSOFT VDD GND VB1 VREF_FIX VB_COMP VSOFT SOFT_START

.ENDS BANDGAP_SOFT_START

*****************BANDGAP*******************
.SUBCKT BANDGAP VDD GND VREF

MQ3 NBIAS NBIAS VDD VDD   PCH3   W=4u L=0.35u
MQ4 NGATE NBIAS VDD VDD   PCH3   W=4u L=0.35u
MQ5 VREF  NBIAS VDD VDD   PCH3   W=4u L=0.35u

MQ1 NBIAS NGATE NX1 GND   NCH3  W=2u L=0.35u
MQ2 NGATE NGATE QB2 GND   NCH3  W=2u L=0.35u

R1 NX1  QB1 9k
R2 VREF QB3 71.2k

Q6 GND GND QB2  pnp10 AREA=1
Q7 GND GND QB1  pnp10 AREA=4
Q8 GND GND QB1  pnp10 AREA=4
Q9 GND GND QB3  pnp10 AREA=1

.ENDS

*****************SOFT_START*******************
.SUBCKT SOFT_START VDD GND VB1 VREF VB_COMP VSOFT

M1 VC1 VB1 VDD VDD   PCH3   W=2u L=17.5u  

C1 VC1 GND 6p
C2 VSOFT GND 120p

X_CMP VDD GND VREF VC1 VB_COMP CMP_OUT CMP01_BG

X_INV VDD GND CMP_OUT CMP_OUT_INV INV_BG

M2 VC1 CMP_OUT_INV GND GND   NCH3  W=2u L=17.5u


X_BUF VDD GND VC1 VBUF VB_COMP VBUF CMP01_BG


RA VBUF  VSOFT 15k

.ENDS


*****************CMP01_BG*******************
.SUBCKT CMP01_BG VDD GND VIN- VIN+ VB_COMP VOUT

M_MB  N_TAIL   VB_COMP  VDD        VDD    PCH3   W=2u L=0.35u M=1

M_MP3 N_LOAD_L VIN+     N_TAIL     VDD    PCH3   W=2u L=0.35u M=2
M_MP4 N_LOAD_R VIN-     N_TAIL     VDD    PCH3   W=2u L=0.35u M=2

M_MN2 N_LOAD_L N_LOAD_L   GND      GND    NCH3   W=2u L=0.35u M=2
M_MN5 N_LOAD_R N_LOAD_R   GND      GND    NCH3   W=2u L=0.35u M=2

